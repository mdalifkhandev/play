{
  "expo": {
    "name": "Play",
    "slug": "play",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "play",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.play",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.play",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A3E635",
          "image": "./assets/images/logo.png",
          "imageWidth": 170
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-notifications",
      "expo-video",
      "expo-audio",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow play to access your camera.",
          "microphonePermission": "Allow play to access your microphone.",
          "recordAudioAndroid": true
        }
      ],
      "expo-image",
      [
        "react-native-square-in-app-payments",
        {
          "cardEntryStyle": {
            "saveButtonText": "Pay",
            "backgroundColor": "#0A0A0A",
            "textColorHint": "#666666",
            "actionBarColor": "#0A0A0A",
            "statusBarColor": "#0A0A0A",
            "editTextStyle": {
              "textColor": "#FFFFFF",
              "accentColor": "#98FF2F",
              "errorColor": "#EF4444"
            }
          }
        }
      ],
      "./plugins/withSquareAndroidFixes",
      [
        "@sentry/react-native/expo",
        {
          "organization": "play-all",
          "project": "play"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
